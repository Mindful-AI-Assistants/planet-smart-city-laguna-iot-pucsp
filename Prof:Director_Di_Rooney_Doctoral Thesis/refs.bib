   title = {Crosstalk analysis of multisection multiconductor lines},
   volume = {41},
   year = {1992},
}
@article{Tominaka2004,
   abstract = {The self-inductance for a twisted bifilar lead is investigated as a function of the twist pitch, as an extension of that for a straight bifilar lead. This calculation method for inductance is based on the numerical integral calculation of the magnetic energy, using the analytical expressions for the vector potentials due to a single helical thin conductor. The calculated results are compared with the experimental measurements, and reasonable agreement is observed.},
   author = {Toshiharu Tominaka and Yoshiaki Chiba},
   doi = {10.1088/0022-3727/37/11/014},
