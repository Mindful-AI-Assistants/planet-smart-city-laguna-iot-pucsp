@article{Su1992,
   abstract = {This paper introduces an effective method for crosstalk characterization and modeling of multisection multiconductor transmission lines as in the case of Tape Automated Bonding (TAB) packages. The method uses two-dimensional field analysis software packages to calculate the electrical parameters of the transmission lines’ sections. These parameters are then used to establish a preliminary model for the multisection multiconductor structure. Time-domain measurement and simulation techniques are then used to refine the model parameters. Using this model, the lines’ coupling behavior (crosstalk) can be predicted. Time-domain measurement applied to a section of a TAB structure is provided to demonstrate the modeling concept, and the corresponding crosstalk waveforms are presented. © 1992 IEEE},
   author = {Wansheng Su and Sedki M. Riad and Aicha Elshabini-Riad and Thomas Poulin},
   doi = {10.1109/19.199436},
   issn = {15579662},
